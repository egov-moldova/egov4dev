@startuml

title <font color=#2094F3><b>ad_ProviderOnboarding</b></font>

skinparam shadowing false
skinparam backgroundColor transparent
skinparam mainframe fontColor #2094F3
skinparam defaultFontStyle bold
skinparam ArrowColor #2094F3
skinparam ArrowFontColor #E6E1E3
skinparam swimlaneBorderColor #2094F3
skinparam swimlaneTitleFontColor #E6E1E3
skinparam swimlaneTitleFontStyle bold
skinparam activity {
    BackgroundColor #E6E1E3
    BorderColor #2094F3
    FontColor #1E2129
    FontStyle bold
    DiamondBackgroundColor #E6E1E3
    DiamondBorderColor #2094F3
    DiamondFontColor #1E2129
    StartColor #2094F3
    EndColor #2094F3
    BarColor #2094F3
}
skinparam note {
    BackgroundColor #E6E1E3
    BorderColor #2094F3
    FontColor #1E2129
}

|QTSP|
start
:Confirm the CA is on the
national trusted list;
:Build and expose the API(s)
(MSign: signing + verification /
MPass: authentication);
:Submit the technical package
(endpoint URLs, WSDL/OpenAPI, API token);
:Submit the branding package
(logo dimensions and format, display texts);
:Agree the operational model with eGov
(error handling, service-downtime handling);

|eGov|
:Prepare the integration agreement
and the integration invoice;

|QTSP|
:Sign the integration agreement;
:Pay the integration invoice;

|eGov|
if (Agreement signed and invoice paid?) then (yes)
  :Schedule the work against current capacity;
  note right
    A queue, not a deprioritisation.
    eGov confirms a start date and
    an estimated delivery time.
  end note
  :Implement the API(s) and configure
  the integration on staging;
else (no)
  :Integration not started;
  end
endif

|QTSP|
:Run functional and non-functional tests
(performance, security);
:Deliver the test reports;

|eGov|
:Acceptance;
:Activate the integration in production;
stop

@enduml
